.library-container {
  width: 400px;
  margin: 40px auto;
  text-align: center;
  font-family: Arial, sans-serif;
}

.search-box {
  width: 90%;
  padding: 8px;
  margin-bottom: 20px;
}

.add-book-form {
  display: flex;
  gap: 10px;
  margin-bottom: 20px;
  justify-content: center;
}

.add-book-form input {
  padding: 6px;
}

.add-book-form button {
  padding: 6px 12px;
  background-color: #4caf50;
  color: white;
  border: none;
  cursor: pointer;
}

.add-book-form button:hover {
  background-color: #45a049;
}

.book-list {
  list-style: none;
  padding: 0;
}

.book-item {
  display: flex;
  justify-content: space-between;
  background: #f4f4f4;
  padding: 10px;
  margin-bottom: 10px;
  border-radius: 5px;
}

.book-item button {
  background-color: #ff4d4d;
  color: white;
  border: none;
  cursor: pointer;
  padding: 5px 10px;
}

.book-item button:hover {
  background-color: #e60000;
}
